# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# --- Local dev / CI (docker-compose) ---
# DIRECT_URL: role bootstrap do container (superuser) — só para migrations e
#   para rodar `npm run db:setup-role` (cria a role restrita abaixo).
# DATABASE_URL: role "barberaria_app" (NOSUPERUSER, NOBYPASSRLS), criada por
#   `npm run db:setup-role` — é a que a app e os testes de isolamento usam,
#   pra RLS ser realmente exercitado (ver scripts/setup-app-role.ts).
DATABASE_URL=postgresql://barberaria_app:barberaria_app@localhost:55432/barberaria
DIRECT_URL=postgresql://barberaria:barberaria@localhost:55432/barberaria

# --- Supabase (staging/produção) ---
# DATABASE_URL: conexão via pooler do Supabase (Supavisor), porta 6543, modo "transaction".
#   Usada pela aplicação em runtime — é onde o SET LOCAL da seção 6.3 do CLAUDE.md precisa funcionar.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexão direta (não-pooled), porta 5432. Usada só por `prisma migrate` (DDL),
#   porque o pooler em modo transaction não sustenta migrations de forma confiável.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Sprint 2) ---
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Secret separado do access token — reduz o raio de dano se um dos dois vazar.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Cache (Sprint 3) ---
# Se ausente, cai no fallback em memória (dev local) — ver src/cache/cache.module.ts.
# REDIS_URL="redis://default:<password>@<host>:<port>"
REDIS_URL=

# --- CORS (Sprint 5) ---
# Origens do(s) front-end(s), separadas por vírgula. Necessário (com credentials)
# pro cookie httpOnly de refresh funcionar entre front e API em portas diferentes.
# 5173 = cliente-app, 5174 = painel-barbearia, 5175 = painel master DesenvolvaIN (desenvolvain-admin, repo separado).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

PORT=3000
NODE_ENV=development
