// Schema fechado na seção 5 do CLAUDE.md — Shared Database, Shared Schema.
// RLS e a migration inicial de tenant_isolation são escritas manualmente em
// prisma/migrations/0001_init/migration.sql, porque o Prisma não modela RLS/policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: aponta para o pooler (Supabase Supavisor, modo transaction) em staging/produção,
  // ou direto para o Postgres local em dev/CI. Ver seção 6.3 do CLAUDE.md.
  url       = env("DATABASE_URL")
  // Migrations (DDL): sempre conexão direta, não-pooled.
  directUrl = env("DIRECT_URL")
}

// `role` é VARCHAR(20) no banco (não enum Postgres), conforme seção 5.1 do CLAUDE.md —
// valores válidos: super_admin | admin | barbeiro | cliente, validados na camada de aplicação.

// Catálogo de planos da plataforma — sem tenant_id de propósito (não é dado
// de tenant, é dado da incubadora, mesmo raciocínio de `tenants` na seção
// 6.4 do CLAUDE.md). `code` é fixo (trial|pro|enterprise, decisão de
// negócio já tomada) e imutável após criado; nome/preço/limite/módulos
// ficam editáveis pela tela de Planos & Preços.
model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(255)
  priceCents Int?     @map("price_cents")
  limitLabel String?  @map("limit_label") @db.VarChar(255)
  modules    Json     @default("[]")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(63)
  name          String   @db.VarChar(255)
  primaryColor  String   @default("#C9A84C") @map("primary_color") @db.VarChar(7)
  secondaryColor String  @default("#0F0F0F") @map("secondary_color") @db.VarChar(7)
  logoUrl       String?  @map("logo_url")
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  users               User[]
  services             Service[]
  professionalServices ProfessionalService[]
  workingHours         WorkingHour[]
  appointments         Appointment[]
  subscription         Subscription?
  payments             Payment[]
  payouts              Payout[]

  @@map("tenants")
}

// Dado do tenant (não da plataforma) — RLS normal, mesmo padrão de
// services/appointments (decisão revista no Sprint 5, ver admin-desenvolvain.md).
// 1 assinatura por tenant (tenantId único); trocar de plano só atualiza a
// mesma linha, sem histórico por enquanto.
model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  status    String   @default("active") @db.VarChar(20)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  payments Payment[]

  @@map("subscriptions")
}

// Registro manual de cobrança da assinatura (Sprint 6) — sem gateway de
// pagamento integrado, o Super Admin registra o que já aconteceu. RLS
// normal, mesmo raciocínio de Subscription.
model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  amountCents    Int       @map("amount_cents")
  period         String    @db.VarChar(20)
  status         String    @default("pending") @db.VarChar(20)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// Repasse de receita da plataforma pra barbearia (Sprint 6) — cálculo é só
// aritmética sobre valores digitados pelo Super Admin (bruto e taxa%), sem
// detecção automática de receita nem regra de taxa fixa. RLS normal.
model Payout {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  period            String   @db.VarChar(50)
  grossRevenueCents Int      @map("gross_revenue_cents")
  feePct            Decimal  @map("fee_pct") @db.Decimal(5, 2)
  netCents          Int      @map("net_cents")
  status            String   @default("pending") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payouts")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  role         String   @db.VarChar(20)
  name         String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  commissionPercentage Decimal? @map("commission_percentage") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  appointmentsAsClient       Appointment[] @relation("AppointmentClient")
  appointmentsAsProfessional Appointment[] @relation("AppointmentProfessional")

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, role], map: "idx_users_tenant")
  @@map("users")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String   @db.VarChar(255)
  priceCents       Int      @map("price_cents")
  durationMinutes  Int      @map("duration_minutes")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, active], map: "idx_services_tenant")
  @@map("services")
}

// professional_id / service_id não têm @relation direta para User/Service aqui de propósito:
// a integridade real é garantida pelas FKs compostas (tenant_id, professional_id) e
// (tenant_id, service_id) escritas manualmente na migration — é isso que impede associação
// cruzada entre tenants. Prisma não modela FK composta parcial (uma coluna já é FK de outra
// relação) de forma nativa, então a tabela é declarada aqui só para gerar o client, e a
// constraint real vem do SQL manual.
model ProfessionalService {
  tenantId       String @map("tenant_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

model WorkingHour {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  weekday        Int      @db.SmallInt
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("working_hours")
}

model Appointment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz
  endsAt         DateTime @map("ends_at") @db.Timestamptz
  status         String   @default("scheduled") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  client       User    @relation("AppointmentClient", fields: [clientId], references: [id])
  professional User    @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  service      Service @relation(fields: [serviceId], references: [id])

  @@index([tenantId, startsAt], map: "idx_appointments_tenant_date")
  @@index([tenantId, professionalId, startsAt], map: "idx_appointments_professional")
  @@index([tenantId, clientId, startsAt], map: "idx_appointments_client")
  @@map("appointments")
}
