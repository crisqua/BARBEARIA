# Copie para .env. Mesma lógica do cliente-app: sem roteamento por subdomínio
# ainda, cada build do painel aponta pra UM tenant via slug.
VITE_API_URL=http://localhost:3000
VITE_TENANT_SLUG=minha-barbearia

# --- Storage de logo (seção 6.1.6) ---
# Chave ANON do Supabase (Project Settings → API) — pública por design, só
# autoriza o upload em conjunto com o token assinado que o backend emite.
# Nunca colocar a SERVICE_ROLE_KEY aqui (essa fica só no backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
